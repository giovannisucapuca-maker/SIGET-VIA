# =====================================================
# SIGET-VÍA — VARIABLES DE ENTORNO
# Copiar como config/.env (no subir .env a GitHub)
# =====================================================

# --- Capa de negocio (API) ---
PORT=4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES

# --- Capa de datos (SQL Server) ---
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=SIGET_VIA_DB
DB_USER=sa
DB_PASSWORD=CAMBIAR_AQUI
DB_ENCRYPT=false
DB_TRUST_CERT=true

# --- Respaldo (npm run respaldo). Vacío = carpeta Backup de SQL Server ---
RESPALDO_DIR=

# --- Capa de datos: servicio externo de consulta de DNI (opcional) ---
APIINTI_API_KEY=

# --- Administrador inicial (npm run seed) ---
ADMIN_EMAIL=admin@siget-via.test
ADMIN_PASSWORD=REEMPLAZAR_CON_CLAVE_SEGURA

# --- Capa de presentación (React) ---
VITE_API_URL=http://localhost:4000/api

